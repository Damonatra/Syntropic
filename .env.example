POSTGRES_DB=syntropic_db
POSTGRES_USER=syntropic
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+asyncpg://syntropic:replace-with-a-long-random-password@syntropic_db:5432/syntropic_db

OIDC_ISSUER=https://identity.example.com/
OIDC_AUDIENCE=syntropic-api
OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
OIDC_CLIENT_ID=syntropic-api-client
OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
OIDC_STATE_SECRET=replace-with-at-least-32-random-characters

# Production hardening: when true, access tokens MUST carry an explicit tenant
# claim (tenant_id / tenant / org_id / organization_id); the subject fallback
# is disabled and such tokens are rejected with HTTP 403. Deploy the IdP change
# (issue tenant_id) BEFORE flipping this to true.
REQUIRE_TENANT_CLAIM=false

# Margin Defender policy (Layer 3 V4). A SKU's floor price is its explicit
# catalog `price_floor`, else unit_cost / (1 - MARGIN_FLOOR_PCT). Quotes below
# unit_cost are always vetoed to human review; quotes below the floor are
# auto-repriced to the floor when MARGIN_REPRICE_ENABLED=true, vetoed when
# false. Catalogs without a usable unit_cost fail closed (veto).
MARGIN_FLOOR_PCT=0.15
MARGIN_REPRICE_ENABLED=true

WEBHOOK_URL=https://erp.example.com/webhooks/rfq
WEBHOOK_HMAC_SECRET=replace-with-at-least-32-random-characters

# Zero-UI Outlook draft dispatch (Layer 4). Requires an Azure AD app
# registration with the Mail.ReadWrite APPLICATION permission and admin
# consent; GRAPH_MAILBOX_ID is the estimator shared mailbox that receives
# completed quote drafts. Deployment gate: an unreachable/locked mailbox
# escalates to the Backbone queue. Disabled deployments never enqueue
# drafts - quotes simply stay in the review queue (graceful degradation).
DISPATCH_ENABLED=false
DISPATCH_SLA_SECONDS=90
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX_ID=estimator-quotes@example.com

# Taelin Memory Stream (Layer 4). Append-only, tenant-partitioned JSONL audit
# stream with tamper-evident hash chaining at {STREAM_ROOT}/{tenant}/stream.log.
# Logs every RFQ ingest, OCR extraction, margin adjustment and draft injection.
# Local filesystem only - no tenant data leaves the deployment boundary.
# Recall SLA: <=30ms for active tenant sessions (see
# scripts/vector2_stream_benchmark.py). Nightly QLoRA exports
# (python -m syntropic.core.stream.finetune_export) scrub PII and raw supplier
# costs by allowlist before any training use.
STREAM_ENABLED=true
STREAM_ROOT=data/streams
STREAM_ROTATE_MB=64
STREAM_FSYNC=false

# ROI Value Ledger + revenue-share reporting (Layer 5). Every margin-defender
# intervention is recorded as an immutable per-job money record (unique per
# tenant+job; anchored to the Taelin stream hash chain). The monthly
# statement endpoint (/api/v1/roi/statement/{year}/{month}) hashes its
# canonical JSON so both parties can verify issuance integrity.
# ROI_SHARE_PCT: contractual share of net margin captured (0-1 scale).
# ROI_DEPLOYMENT_COST: one-time deployment fee used for payback progress.
# ROI_REPORTING_CURRENCY: primary billing ISO code; money in other
# currencies is reported per-bucket and never summed across ISO codes.
ROI_LEDGER_ENABLED=true
ROI_SHARE_PCT=0.20
ROI_DEPLOYMENT_COST=50000
ROI_REPORTING_CURRENCY=USD

# Optional LangSmith tracing. Add your private API key to .env; do not commit it.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=syntropic-enterprise-production
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Browser-facing API URL used by the Next.js workstation.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
