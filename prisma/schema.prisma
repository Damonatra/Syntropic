// Vertebra Console — operational store for the lead & intelligence engine.
// SQLite for the sandbox console; the Python engine mirrors these contracts
// on Neon Postgres (see vertebra/db/migrations.sql).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Prospect {
  id                 String   @id @default(cuid())
  source             String   @default("console")
  sourceUrl          String   @default("console://manual-entry")
  name               String
  domainKey          String // dedupe key: domain || normalised name
  domain             String?
  website            String?
  vertical           String?
  region             String?
  city               String?
  stateProvince      String?
  country            String?
  postalCode         String?
  employeeCount      Int?
  revenueEstimateUsd Int?
  revenueConfidence  String   @default("unknown")
  detectedErp        String?
  erpMetadata        String? // Module 5: full erp_metadata JSON document
  quotePortalType    String? // Module 5: manual_mailto | static_pdf_form | legacy_portal | modern_quote_api | undetermined
  auditImageUrl      String? // Module 6: public CDN link of the audit preview
  latitude           Float? // Module 7: geocoded HQ/warehouse coordinates
  longitude          Float?
  clusterId          String? // Module 7: membership in a tactical cluster
  cluster            LeadCluster? @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  lastIntentHeat     Int      @default(0) // Module 8: rolling 14-day intent heat
  rawExcerpt         String?
  ingestion          String   @default("pending") // pending | ingested | filtered | failed
  filterReason       String?
  caslScope          Boolean  @default(false)
  caslReason         String?
  bestEmail          String?
  emailPattern       String?
  contacts           Contact[]
  scores             Score[]
  dispatches         Dispatch[]
  highTouch          HighTouchQueueItem?
  telemetryEvents    TelemetryEvent[]
  intentAlerts       IntentAlert[]
  inboundReplies     InboundReply[]
  operatorActions    OperatorAction[]
  painSignals        PainSignal[]
  engagements        Engagement[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([source, domainKey])
  @@index([ingestion])
}

model Contact {
  id         String   @id @default(cuid())
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  prospectId String
  firstName  String
  lastName   String
  role       String   @default("unknown")
  titleRaw   String?
  phone      String? // Module 8: direct line surfaced in high-intent alerts
  linkedinUrl String? // engine enrichment: contact LinkedIn profile
  createdAt  DateTime @default(now())

  @@index([prospectId])
}

model Score {
  id           String   @id @default(cuid())
  prospect     Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  prospectId   String
  qlvScore     Int
  band         String
  factorsJson  String
  hooksJson    String
  rationale    String
  model        String
  fingerprint  String   @unique
  createdAt    DateTime @default(now())

  @@index([prospectId])
}

model Dispatch {
  id            String   @id @default(cuid())
  prospect      Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  prospectId    String
  channel       String // channel_a_automated_email | channel_b_josias_high_touch
  status        String   @default("queued")
  caslScope     Boolean  @default(false)
  subject       String?
  body          String?
  fromDomain    String?
  provider      String?
  providerMsgId String?
  footerApplied String?
  scheduledAt   DateTime? // Module 4/9: sequence step schedule (OOO replies push this forward)
  briefHash     String? // personalization integrity: fingerprint of the evidence brief the draft was built from
  verifyReportJson String? // deterministic verify report for the exact subject/body that left the enclave
  error         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
}

model OutboxEvent {
  id            String    @id @default(cuid())
  aggregateType String
  aggregateId   String
  eventType     String
  payload       String
  attempts      Int       @default(0)
  lastError     String?
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([publishedAt])
}

model HighTouchQueueItem {
  id              String    @id @default(cuid())
  prospect        Prospect  @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  prospectId      String    @unique
  qlvScore        Int
  qlvBand         String
  topHook         String
  rationale       String
  calendarEventId String?
  exportedAt      DateTime?
  createdAt       DateTime  @default(now())
}

// --------------------------------------------------------------------------
// Modules 5-9 — advanced tactical extensions (mirror of migrations.sql)
// --------------------------------------------------------------------------

model LeadCluster {
  id             String    @id @default(cuid())
  clusterKey     String    @unique // deterministic hash for idempotent re-runs
  clusterName    String
  anchorCity     String?
  anchorCountry  String?
  centroidLat    Float
  centroidLng    Float
  radiusM        Int       @default(0)
  densityCount   Int       @default(0)
  verticalFocus  String?
  prospects      Prospect[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model TelemetryEvent {
  id          String             @id @default(cuid())
  prospect    Prospect?          @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  prospectId  String?
  sessionId   String
  eventType   String // portal_visit | audit_view | document_download | pricing_view | session_end
  url         String?
  referrer    String?
  city        String?
  country     String?
  latitude    Float?
  longitude   Float?
  userAgent   String?
  device      String?
  durationMs  Int?
  payloadJson String?
  occurredAt  DateTime           @default(now())

  @@index([prospectId, occurredAt])
  @@index([sessionId])
}

model IntentAlert {
  id                String    @id @default(cuid())
  prospect          Prospect  @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  prospectId        String
  title             String
  body              String
  dedupeKey         String?
  channelsAttempted String    @default("[]")
  channelsDelivered String    @default("[]")
  delivered         Boolean   @default(false)
  acknowledgedAt    DateTime? // operator saw it (toast displayed / acked)
  createdAt         DateTime  @default(now())

  @@index([dedupeKey, createdAt])
  @@index([prospectId])
}

model InboundReply {
  id               String       @id @default(cuid())
  prospect         Prospect?    @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  prospectId       String?
  messageId        String?
  fromEmail        String
  subject          String?
  body             String
  intent           String       @default("unknown") // interested | out_of_office | send_information | not_interested | objection_price | objection_erp | unknown
  intentConfidence Float?
  rationale        String?
  extractedJson    String?
  processedAt      DateTime?
  receivedAt       DateTime     @default(now())
  createdAt        DateTime     @default(now())
  drafts           AgentDraft[]

  @@index([processedAt])
  @@index([prospectId])
}

// Command centre — operator decision log (call / defer / snooze / triage moves).
// actor carries the signed-in operator's username ("josias" | "damon") —
// "operator" only when the gate is off (sandbox default) or for system-ish
// writers on public routes (unsubscribe links fired by prospects).
model OperatorAction {
  id         String   @id @default(cuid())
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  prospectId String
  action     String // called | deferred | snoozed | booked | note | emailed
  note       String?
  actor      String   @default("operator")
  createdAt  DateTime @default(now())

  @@index([prospectId])
}

/// Per-operator enclave accounts — the door is identity, not a shared
/// password. Passwords are stored ONLY as scrypt hashes (node:crypto,
/// salted, timing-safe compare); plaintext never touches the database or
/// the repo. username is the lowercase handle used in trails and acks;
/// displayName is how the name renders everywhere ("Josias", "Damon");
/// role is the title the checkpoint signs them with ("CEO", "Executive
/// Lead") — empty falls back to the legacy "Operator" label.
model Operator {
  id           String    @id @default(cuid())
  username     String    @unique
  displayName  String
  role         String    @default("")
  passwordHash String // scrypt$N$r$p$<salt b64>$<hash b64>
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
}

model AgentDraft {
  id           String       @id @default(cuid())
  reply        InboundReply @relation(fields: [replyId], references: [id], onDelete: Cascade)
  replyId      String
  prospectId   String?
  intent       String
  subject      String
  body         String
  status       String       @default("pending_human_review") // pending_human_review | approved | sent | discarded
  reviewerNote String?
  sentAt       DateTime?
  createdAt    DateTime     @default(now())

  @@index([status])
}

// --------------------------------------------------------------------------
// Loop-closure extensions — suppression, audit intake
// --------------------------------------------------------------------------

/// CASL / CAN-SPAM suppression ledger. Any address (or prospect) here is
/// never emailed again; checked by the sequence ticker and the draft sender.
model SuppressionRecord {
  id         String   @id @default(cuid())
  email      String   @unique
  prospectId String?
  reason     String   @default("unsubscribe") // unsubscribe | complaint | bounce | manual
  source     String   @default("unsubscribe_link") // unsubscribe_link | operator | engine
  createdAt  DateTime @default(now())

  @@index([prospectId])
}

/// Real audit-dropzone intake: files parsed server-side by /api/audit/parse.
/// Findings carry only what extraction actually recovered — never fabricated.
/// M3 binds documents to a paid Engagement so parsed evidence accumulates
/// as audit forensics instead of evaporating.
model AuditDocument {
  id           String      @id @default(cuid())
  prospectId   String?
  engagementId String?
  engagement   Engagement? @relation(fields: [engagementId], references: [id], onDelete: SetNull)
  fileName     String
  mimeType     String
  sizeBytes    Int
  sha256       String
  pages        Int?
  lineItems    Int?
  extraction   String      @default("partial") // full_text | partial | header_only
  findingsJson String?
  createdAt    DateTime    @default(now())

  @@index([createdAt])
  @@index([sha256])
  @@index([engagementId])
}

/// Paid engagements from the executive portal on the landing page — the
/// bridge where client money becomes operator work. Rows arrive either via
/// the HMAC-signed /api/portal/ingest webhook (source portal_webhook) or the
/// desk's manual fallback (source manual). Idempotent on the payment ref:
/// the landing page can retry safely and the ledger never double-books.
/// The stage machine: paid → intake → forensics → verdict → delivered →
/// sow | closed. The verdict stage records the $10,000 guarantee decision
/// (guaranteeCleared + confirmedLeakageUsd) — the contract, enforced honestly.
model Engagement {
  id                  String    @id @default(cuid())
  ref                 String    @unique
  clientName          String
  clientDomain        String?
  contactName         String?
  contactEmail        String?
  contactPhone        String?
  tier                String    @default("diagnostic_audit") // diagnostic_audit | enterprise_sow
  amountUsd           Int
  source              String    @default("manual") // portal_webhook | manual
  status              String    @default("paid") // paid | intake | forensics | verdict | delivered | sow | closed
  ingestPayload       String? // verbatim signed payload — provenance, never edited
  intakeRfqPerMonth   Int?
  intakeLineItems     Int?
  guaranteeCleared    Boolean? // null = undecided; the audit contract in one bit
  confirmedLeakageUsd Int? // operator-confirmed recoverable leakage at verdict
  verdictNote         String?
  deliverableUrl      String? // M4: generated audit PDF path
  prospectId          String?
  prospect            Prospect? @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  documents           AuditDocument[]
  events              EngagementEvent[]
  paidAt              DateTime  @default(now())
  deliveredAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status])
  @@index([prospectId])
}

/// Append-only trail for every engagement movement — the honesty ledger the
/// desk renders and the operator (or webhook) writes. Never deleted.
model EngagementEvent {
  id           String     @id @default(cuid())
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  engagementId String
  kind         String // ingested | stage_changed | document_added | verdict_recorded | prospect_linked | deliverable_generated | note | delivered
  detail       String?
  actor        String     @default("operator") // operator | portal_webhook | system
  createdAt    DateTime   @default(now())

  @@index([engagementId, createdAt])
}

/// Hourly KPI input captures for the 24h baseline deltas on the RADAR strip.
/// The /api/command aggregator appends at most one row per hour and reads the
/// newest capture older than 24h as the comparison point — no fake history,
/// deltas appear once the ledger has genuinely accumulated.
model CommandBaseline {
  id          String   @id @default(cuid())
  capturedAt  DateTime @default(now())
  metricsJson String // KpiInputs document — see src/lib/vertebra/command.ts

  @@index([capturedAt])
}

/// Verbatim pain evidence per prospect — the raw material for 1:1 cold email.
/// A prospect feels seen when a sentence would be false for any other company
/// on the list; that requires quotes from their own world, never summaries and
/// never inventions. Every signal carries provenance and can be vetoed by the
/// operator; drafts are built from the active set and hashed into the Dispatch.
model PainSignal {
  id         String   @id @default(cuid())
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  prospectId String
  kind       String // review_complaint | site_copy | job_posting | reply_language | telemetry | audit_finding | operator_note | research
  verbatim   String // exact words — the texture that makes the email land
  context    String?  // one line of surrounding context
  sourceUrl  String?
  sourceNote String?  // human-readable provenance when no URL exists
  confidence String   @default("medium") // high | medium | low
  status     String   @default("active") // active | vetoed
  createdAt  DateTime @default(now())

  @@index([prospectId, status])
}

/// Operator acknowledgements for derived ops alerts — the watchtower's
/// memory. Alerts themselves are never stored: they are re-derived from real
/// rows at every snapshot build, so an ack only needs to suppress the exact
/// (watch, subject, window) key it named. The window bucket in the key means
/// a condition that clears and refires later comes back as a new key — the
/// operator is never nagged within a window, never silenced forever.
/// The reason is the tuning loop's raw material: false-positive acks roll up
/// into per-watch hit rates, so threshold tuning becomes data, not opinion.
model OpsAlertAck {
  id        String   @id @default(cuid())
  alertKey  String   @unique
  actor     String   @default("operator")
  /// "real" | "false_positive" | "handled" — operator's verdict on the fire.
  reason    String   @default("real")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Egress ledger — every domain the enclave may ever send from, and the
/// warmup discipline each one is under. The mailer's third interlock reads
/// this table: a domain that is not registered, not DNS-verified, or over
/// its warmup cap cannot leave the building (live egress only — the staged
/// sandbox is unaffected). Sending cold email from the company's main
/// domain is how a reputation dies in a week; the ledger makes that
/// mistake structurally impossible rather than a matter of memory.
///
/// The warmup ramp lives in lib/vertebra/warmup.ts — caps are derived from
/// warmupStartedAt, never invented per-row. status transitions:
///   spare    registered, warmup not started (no live sends)
///   warming  on the ramp — daily cap grows with the schedule
///   ready    ramp plateaued — full cap
///   paused   operator hold — refuses live egress, keeps the history
///   burned   reputation lost (watch evidence) — retired, never deleted
model SendingDomain {
  id              String    @id @default(cuid())
  domain          String    @unique
  role            String    @default("sending") // sending | transactional
  dnsStatus       String    @default("pending") // pending | dns_added | verified
  providerRef     String? // Resend domain id once added in the dashboard
  warmupStartedAt DateTime?
  status          String    @default("spare") // spare | warming | ready | paused | burned
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
}

/// Flap ledger — one row per (watch, subject, hour) the condition was live.
/// Alerts are derived, so presence in a snapshot build is the only fire
/// signal; recording distinct hour buckets gives honest refire counts
/// ("fired 4× / 24h") without ever double-counting a single sweep. A watch
/// that is chronically live becomes its own alarm: the watchtower watching
/// its own accuracy.
model OpsWatchFire {
  id         String   @id @default(cuid())
  watchKey   String // `${watchId}:${subjectId ?? "system"}`
  hourBucket Int // floor(epochMs / 3_600_000)
  lastFireAt DateTime @default(now())

  @@unique([watchKey, hourBucket])
  @@index([watchKey])
  @@index([lastFireAt])
}

/// Heartbeat pulses from external engines — the engine contract's ingress
/// ledger. The document turnaround engine (or any watch reporter) POSTs a
/// signed pulse per watch update to /api/ops/heartbeat; the watch layer
/// merges these into the deck alongside native watches. Idempotent on
/// (engineId, pulseRef) so retries are free. expectEveryMs is the engine's
/// declared cadence — when it goes silent past 3× cadence the watch fires.
model EnginePulse {
  id            String   @id @default(cuid())
  engineId      String
  pulseRef      String
  watchId       String
  status        String   @default("ok") // ok | warn | fail
  detail        String?
  metricsJson   String?
  expectEveryMs Int?
  at            DateTime @default(now())

  @@unique([engineId, pulseRef])
  @@index([engineId, at])
  @@index([watchId, at])
}
