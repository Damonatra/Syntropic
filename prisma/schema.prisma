// Vertebra Console — operational store for the lead & intelligence engine.
// SQLite for the sandbox console; the Python engine mirrors these contracts
// on Neon Postgres (see vertebra/db/migrations.sql).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Prospect {
  id                 String   @id @default(cuid())
  source             String   @default("console")
  sourceUrl          String   @default("console://manual-entry")
  name               String
  domainKey          String // dedupe key: domain || normalised name
  domain             String?
  website            String?
  vertical           String?
  region             String?
  city               String?
  stateProvince      String?
  country            String?
  postalCode         String?
  employeeCount      Int?
  revenueEstimateUsd Int?
  revenueConfidence  String   @default("unknown")
  detectedErp        String?
  erpMetadata        String? // Module 5: full erp_metadata JSON document
  quotePortalType    String? // Module 5: manual_mailto | static_pdf_form | legacy_portal | modern_quote_api | undetermined
  auditImageUrl      String? // Module 6: public CDN link of the audit preview
  latitude           Float? // Module 7: geocoded HQ/warehouse coordinates
  longitude          Float?
  clusterId          String? // Module 7: membership in a tactical cluster
  cluster            LeadCluster? @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  lastIntentHeat     Int      @default(0) // Module 8: rolling 14-day intent heat
  rawExcerpt         String?
  ingestion          String   @default("pending") // pending | ingested | filtered | failed
  filterReason       String?
  caslScope          Boolean  @default(false)
  caslReason         String?
  bestEmail          String?
  emailPattern       String?
  contacts           Contact[]
  scores             Score[]
  dispatches         Dispatch[]
  highTouch          HighTouchQueueItem?
  telemetryEvents    TelemetryEvent[]
  intentAlerts       IntentAlert[]
  inboundReplies     InboundReply[]
  operatorActions    OperatorAction[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([source, domainKey])
  @@index([ingestion])
}

model Contact {
  id         String   @id @default(cuid())
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  prospectId String
  firstName  String
  lastName   String
  role       String   @default("unknown")
  titleRaw   String?
  phone      String? // Module 8: direct line surfaced in high-intent alerts
  linkedinUrl String? // engine enrichment: contact LinkedIn profile
  createdAt  DateTime @default(now())

  @@index([prospectId])
}

model Score {
  id           String   @id @default(cuid())
  prospect     Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  prospectId   String
  qlvScore     Int
  band         String
  factorsJson  String
  hooksJson    String
  rationale    String
  model        String
  fingerprint  String   @unique
  createdAt    DateTime @default(now())

  @@index([prospectId])
}

model Dispatch {
  id            String   @id @default(cuid())
  prospect      Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  prospectId    String
  channel       String // channel_a_automated_email | channel_b_josias_high_touch
  status        String   @default("queued")
  caslScope     Boolean  @default(false)
  subject       String?
  body          String?
  fromDomain    String?
  provider      String?
  providerMsgId String?
  footerApplied String?
  scheduledAt   DateTime? // Module 4/9: sequence step schedule (OOO replies push this forward)
  error         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
}

model OutboxEvent {
  id            String    @id @default(cuid())
  aggregateType String
  aggregateId   String
  eventType     String
  payload       String
  attempts      Int       @default(0)
  lastError     String?
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([publishedAt])
}

model HighTouchQueueItem {
  id              String    @id @default(cuid())
  prospect        Prospect  @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  prospectId      String    @unique
  qlvScore        Int
  qlvBand         String
  topHook         String
  rationale       String
  calendarEventId String?
  exportedAt      DateTime?
  createdAt       DateTime  @default(now())
}

// --------------------------------------------------------------------------
// Modules 5-9 — advanced tactical extensions (mirror of migrations.sql)
// --------------------------------------------------------------------------

model LeadCluster {
  id             String    @id @default(cuid())
  clusterKey     String    @unique // deterministic hash for idempotent re-runs
  clusterName    String
  anchorCity     String?
  anchorCountry  String?
  centroidLat    Float
  centroidLng    Float
  radiusM        Int       @default(0)
  densityCount   Int       @default(0)
  verticalFocus  String?
  prospects      Prospect[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model TelemetryEvent {
  id          String             @id @default(cuid())
  prospect    Prospect?          @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  prospectId  String?
  sessionId   String
  eventType   String // portal_visit | audit_view | document_download | pricing_view | session_end
  url         String?
  referrer    String?
  city        String?
  country     String?
  latitude    Float?
  longitude   Float?
  userAgent   String?
  device      String?
  durationMs  Int?
  payloadJson String?
  occurredAt  DateTime           @default(now())

  @@index([prospectId, occurredAt])
  @@index([sessionId])
}

model IntentAlert {
  id                String    @id @default(cuid())
  prospect          Prospect  @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  prospectId        String
  title             String
  body              String
  dedupeKey         String?
  channelsAttempted String    @default("[]")
  channelsDelivered String    @default("[]")
  delivered         Boolean   @default(false)
  acknowledgedAt    DateTime? // operator saw it (toast displayed / acked)
  createdAt         DateTime  @default(now())

  @@index([dedupeKey, createdAt])
  @@index([prospectId])
}

model InboundReply {
  id               String       @id @default(cuid())
  prospect         Prospect?    @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  prospectId       String?
  messageId        String?
  fromEmail        String
  subject          String?
  body             String
  intent           String       @default("unknown") // interested | out_of_office | send_information | not_interested | objection_price | objection_erp | unknown
  intentConfidence Float?
  rationale        String?
  extractedJson    String?
  processedAt      DateTime?
  receivedAt       DateTime     @default(now())
  createdAt        DateTime     @default(now())
  drafts           AgentDraft[]

  @@index([processedAt])
  @@index([prospectId])
}

// Command centre — operator decision log (call / defer / snooze / triage moves).
model OperatorAction {
  id         String   @id @default(cuid())
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  prospectId String
  action     String // called | deferred | snoozed | booked | note | emailed
  note       String?
  createdAt  DateTime @default(now())

  @@index([prospectId])
}

model AgentDraft {
  id           String       @id @default(cuid())
  reply        InboundReply @relation(fields: [replyId], references: [id], onDelete: Cascade)
  replyId      String
  prospectId   String?
  intent       String
  subject      String
  body         String
  status       String       @default("pending_human_review") // pending_human_review | approved | sent | discarded
  reviewerNote String?
  sentAt       DateTime?
  createdAt    DateTime     @default(now())

  @@index([status])
}

// --------------------------------------------------------------------------
// Loop-closure extensions — suppression, audit intake
// --------------------------------------------------------------------------

/// CASL / CAN-SPAM suppression ledger. Any address (or prospect) here is
/// never emailed again; checked by the sequence ticker and the draft sender.
model SuppressionRecord {
  id         String   @id @default(cuid())
  email      String   @unique
  prospectId String?
  reason     String   @default("unsubscribe") // unsubscribe | complaint | bounce | manual
  source     String   @default("unsubscribe_link") // unsubscribe_link | operator | engine
  createdAt  DateTime @default(now())

  @@index([prospectId])
}

/// Real audit-dropzone intake: files parsed server-side by /api/audit/parse.
/// Findings carry only what extraction actually recovered — never fabricated.
model AuditDocument {
  id           String   @id @default(cuid())
  prospectId   String?
  fileName     String
  mimeType     String
  sizeBytes    Int
  sha256       String
  pages        Int?
  lineItems    Int?
  extraction   String   @default("partial") // full_text | partial | header_only
  findingsJson String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([sha256])
}

/// Hourly KPI input captures for the 24h baseline deltas on the RADAR strip.
/// The /api/command aggregator appends at most one row per hour and reads the
/// newest capture older than 24h as the comparison point — no fake history,
/// deltas appear once the ledger has genuinely accumulated.
model CommandBaseline {
  id          String   @id @default(cuid())
  capturedAt  DateTime @default(now())
  metricsJson String // KpiInputs document — see src/lib/vertebra/command.ts

  @@index([capturedAt])
}
